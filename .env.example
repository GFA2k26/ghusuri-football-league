# GFL 2026 production configuration
NODE_ENV=production
PORT=3000

# MUST be changed for public hosting
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ADMIN_PASSWORD=replace-with-your-admin-password

# Persistent storage. On a VPS/Render persistent disk, point DATA_DIR to that disk.
DATA_DIR=./data
PUBLIC_UPLOADS_DIR=./data/uploads
PRIVATE_UPLOADS_DIR=./data/private
BACKUP_DIR=./data/backups
DB_FILE=gfl.sqlite

# Gmail SMTP (optional but required for registration/status emails)
GFL_EMAIL_USER=
GFL_EMAIL_APP_PASSWORD=
GFL_EMAIL_FROM=
